int fd = socket;
bind(fd,8080);
listen(fd);
while(0<1) {
    int cfd = accept(fd);
    string req = read(cfd);
    ctxsource(""); //Initilize
    Node handle;
    aboveasbelow;
    emit_block {
        script "
            function post(body) {
                 console.log(\"Button was clicked!\");
                fetch(window.location.pathname, {
                    method: \"POST\",
                    body: body
                })
            }
        ";

        text "wub" {
            "color" : "purple";
            "onclick" : "post('wub')";
        }

        div twub {

        }
    }

    print("REQ: ",req);

    string first_line = req.substr(0, req.find("\r\n"));
    string method = first_line.substr(0, first_line.find(" "));
    string path = first_line.slice(" ", 1, 2);
    print("Method: ",method);
    print("Path: ",path);

  

    string response = "";
        response.append("HTTP/1.1 200 OK\r\n");
        response.append("Content-Type: text/html\r\n");
        response.append("Content-Length: ");
        response.append(to_string(ctxsource.length));
        response.append("\r\n\r\n");
        response.append(ctxsource);
        print("RESPONSE: ",response);
    write(cfd,response);  

    Node page = handle.scopes.get(0);
    for(int i=0;i<page.children.length;i=i+1) {
        page.children.get(i).name.append("not wub");
    }

    response.clear;  
    ctxsource.clear;
}


