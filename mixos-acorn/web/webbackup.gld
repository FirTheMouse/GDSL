    }

    "component" {
        on ".\"tested\"" int {
            print("TESTING ON!!");
            ctx.node.value.set(3);
        }
    }
##

root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");

    template div wubria {
        "background-color" : "blue";
        text "testing";
    }
    wubria;

    div wub {
        text "testing" {
            "onclick" : {
                Node n = call_owner(wub);
                n.scopes.get(0).children.get(0).children.get(0).name = "iswub";
                emit_reload(ctx,n);
            }
        }
        "background-color" : "red";
    }
    print(wub.tested);
}

