int func(int depth) {
    print("DEPTH: ",depth);
    if(depth<10) {
        for(int i=0;i<4;i++) {
            print(i);
            if(i==1) {
                func(depth+1);
            }
        }
    } else {
        print("That's enough");
    }
}

