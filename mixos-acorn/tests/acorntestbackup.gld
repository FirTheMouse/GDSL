Signatures testing

##
    register wub;
    "wub" {
        in executing {
            subprocess(ctx);
            if(ctx.node.type!=#wub) {
                execut(ctx.node);
            } else {
                print("WUBBING!");
                print(ctx.node.children.get(0).name," -W- ",ctx.node.children.get(1));
            }
        }
    }
    register twub;
    "twub" {
        in executing {
            subprocess(ctx);
            if(ctx.node.type!=#twub) {
                execut(ctx.node);
            } else {
                print("Twubbing!");
                print(ctx.node.children.get(0)," -T- ",ctx.node.children.get(1));
            }
        }
    }
    register thrub;
    "thrub" {
        in executing {
            int old_type = ctx.node.type;
            subprocess(ctx);
            if(old_type!=ctx.node.type) {
                execut(ctx.node);
            } else {
                print("thrubbing.");
                print(ctx.node.children.get(0)," -H- ",ctx.node.children.get(1));
            }
        }
    }
