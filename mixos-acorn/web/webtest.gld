##
    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source.append("<p");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).value.getStr);
            source.append("</p>");
            emit_contents;
        }
    }

    register script;
    "script" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
            resolv(node.children.get(0));
        }
        in htmlemiting {
            source.append("<script");
            emit_inline_html;
            source.append(">");
            execut(node.children.get(0));
            source.append(node.children.get(0).value.getStr);
            source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source.append("<style");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).name);
            source.append("</style>");
        }
    }

    "FUNC_DECL" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            if(node.value.type==to_type("inlined")) {return;}
            if(node.value.type==to_type("invisible")) {return;}
            source.append("<div");
            emit_inline_html;
            source.append(">");
            emit_contents;
            source.append("</div>");
        }
    }
    "FUNC_CALL" {
        in htmlemiting {
            if(node.value.type==to_type("inlined")) {return;}
            if(node.value.type==to_type("invisible")) {return;}
            source.append("<div");
            emit_inline_html;
            source.append(">");
            emit_contents;
            source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            source.append("<html><body>");
            emit_contents;
            source.append("</body></html>");
        }
    }

    register aboveasbelow;
    "aboveasbelow" {
        in executing {
            result.get(index-1).value.data(result.get(index+1));
        }
    }

##

Node twig = compile(read_file("mixos-acorn/web/thistle.twg"));
Node page = twig.children.get(0);
execut twig;

int fd = socket;
bind(fd,8080);
listen(fd);
while(0<1) {
    int cfd = accept(fd);
    string req = read(cfd);

    string first_line = req.substr(0, req.find("\r\n"));
    string method = first_line.substr(0, first_line.find(" "));
    string slashpath = first_line.slice(" ", 1, 2);
    string path = slashpath.substr(1,slashpath.length-1); //Strip the slash
    print("Method: ",method);
    print("Slashpath: ",slashpath);
    print("Path: ",path);

    if(path.length==0) {
        path = "root_path"; //For routing
    }
    for(int i=0;i<twig.children.length;i++) {
        Node child = twig.children.get(i);
        if(labels(child.type)==path) {
            page = child; //Because I haven't added break yet
        }
    }

    string response_body = "";
    response_body.clear; //Until we perfect temporary lifetimes

    if(method=="GET") {
        ctxsource(""); //Initilize
        ctxsource.clear;
        htmlemit page;
        response_body.append(ctxsource);
    }

    if(method=="POST") {
        print(req);
    }

    if(method=="FRAG") {
        int body_start = req.find("\r\n\r\n");
        if(body_start>=0) {
            string src = req.slice(body_start+4,req.length);
            ctxsource.clear;
            ctxsource(src); //Initilize
            frag page;
            response_body.append(ctxsource);
        }
    }

    string response = "";
        response.append("HTTP/1.1 200 OK\r\n");
        response.append("Content-Type: text/html\r\n");
        response.append("Content-Length: ");
        response.append(to_string(response_body.length));
        response.append("\r\n\r\n");
        response.append(response_body);
        print("RESPONSE: ",response);
    write(cfd,response); 
    close(cfd);

    response_body.clear;
    response.clear;  
    req.clear;
    ctxsource.clear;
}
