##
    global string render_as_sheet(Node node) {
        std::string out = "";
        out += "</table>";
        return out;
    }

    register admin;
    "admin" {
        in htmlemiting {
            emit_contents;
        }
        in fraging {
            string src = ctx.source;
            string target = src.slice(0,src.find(" "));
            string instr = src.slice(" ",1,2);
            string content = src.slice(src.find(" ",0,2)+1,src.length);
            print("TARGET: ",target); 
            print("INSTR: ",instr); 
            print("CONTENT: ",content); 
            
            if(target.length!=0) {
                Node to_edit = find_node(target,ctx.node);
                ctx.source = "";
                ctx.source = render_as_sheet(to_edit);
            } else {
                print("No target for frag request!");
            }
        }
    }
##

template div std_render_sheet(int spool) {
    div {
        "display" : "flex";
        "justify-content" : "center";
        "width" : "100%";
            table {
                "border-collapse" : "collapse";
                "width" : "100%";
                    int lenc = plen(spool); //Columns
                    int lenr = 0; //Rows

                    //Headers
                    row {
                        for(int i=0;i<lenc;i++) {
                            column {
                                "background-color" : "rgb(240, 240, 240)";
                                "padding" : "10px 12px";
                                "font-size" : "14px";
                                "color" : "rgb(26, 26, 26)";
                                "font-size" : "13px";
                                "font-weight" : "600";
                                "color" : "rgb(80,80,80)";
                                "font-family" : "system-ui, sans-serif";
                                "border-right" : "1px solid rgb(200,200,200)";
                                text clabel(spool,i);
                            }
                            int lenco = clen(spool,i);
                            if(lenco>lenr) {
                                lenr = lenco;
                            }
                        }
                    }
                    
                    //Render each column
                    for(int r=0;r<lenr;r++) {
                        row {
                            "border-bottom" : "1px solid rgb(220,220,220)";
                                for(int c=0;c<lenc;c++) {
                                    column {
                                        "border-right" : "1px solid rgb(200,200,200)";
                                            string tostr = "";
                                            Ptr cellptr = makePtr3(spool,c,r);
                                            Ptr p = resolve_as_Ptr(cellptr);
                                            if(is_live(p)) {
                                                tostr = value_as_string(p);
                                            }
                                            input {
                                                "border" : "none";
                                                "background-color" : "transparent";
                                                "width" : "100%";
                                                "padding" : "8px 4px";
                                                "font-size" : "13px";
                                                "font-family" : "system-ui, sans-serif";
                                                "value" : tostr;                                                                    
                                                "onchange" : escape_str("run_raw('setcell(\""+to_string(cellptr)+"=',this.value,'\")')");
                                            }
                                    }
                                }
                        }
                    }
            }
    }
}

admin {
    div {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                box-sizing: border-box;
            }
        ";
        script read_file("mixos-acorn/web/thistle/thistle.js");

        "display" : "flex";
        "min-height" : "100vh";
            side_bar;
            background_theme;


            template div control_btns(string label, string behaviour) { 
                button instance {
                    "onclick" : behaviour; 
                    "height" : "100%"; 
                    "width" : "40px"; 
                    text label { text_theme; }
                } 
            }

            control_btns("S",escape_str("run_raw('save_sheet("+to_string(sheetpool)+",\"redberry\")')"));
            control_btns("+C",escape_str("run_raw('add_column_to_sheet("+to_string(sheetpool)+")')"));
            control_btns("+R",escape_str("run_raw('add_row_to_sheet("+to_string(sheetpool)+")')"));

            div {
                "flex" : "1";
                "display" : "flex";
                "flex-direction" : "column";
                "justify-content" : "center";
                "align-items" : "center";
                    div {
                        "display" : "flex";
                        "justify-content" : "flex-start";
                        "align-items" : "stretch";
                        "flex-direction" : "column";
                        "width" : "480px";
                        "padding" : "40px";
                        "gap" : "12px";
                        card_theme;
                        "border-radius" : "12px";
                        "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";
                        if(sheetpool!=0) {
                            std_render_sheet(sheetpool);
                        }
            }
        }
    }
