##
    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("p",false,"",ctx.node.children.get(0).value.getStr);
        }
    }
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html>");
            subemit("body",false,"","");
            ctx.source.append("</html>");
            print(ctx.source);
        }
    }
##

emit_block {
    text "hey";
}