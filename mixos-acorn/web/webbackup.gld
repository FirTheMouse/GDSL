int func(int depth) {
    print("DEPTH: ",depth);
    if(depth<10) {
        for(int i=0;i<4;i++) {
            print(i);
            if(i==1) {
                func(depth+1);
            }
        }
    } else {
        print("That's enough");
    }
}

func(0);




    ##

    Node emitter;

    int emit_contents {
        if(node.scopes.length>0) {
            Node scope = node.scopes.get(0);
            print("emitting ",scope.children.length," children");
            for(int i=0;i<scope.children.length;i=i+1) {
                Node child = scope.children.get(i);
                print(i," EMITTING ",child.name);
                htmlemit child;
                print("DONE");
            }
        }
    }


    newstage htmlemiting;

    register text;
    "text" {
        in naming {
            node.name = result.take(index+1).name;
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source(subsource);
            source.append("<p");
            emit_inline_html;
            source.append(">");
            source.append(node.name);
            source.append("</p>");
            emit_contents;
        }
    }

    register script;
    "script" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source(subsource);
            source.append("<script");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).name);
            source.append("</script>");
        }
    }

    "FUNC_DECL" {
        in htmlemiting {
            print("FUNC DECL");
            source(subsource);
            source.append("<p>");
            source.append("this is a div");
            source.append("</p>");
            emit_contents;
        }
    }

    register emit_block;
    "emit_block" {
        in executing {
            source.append("<html><body>");
            emit_contents;
            source.append("<body></html>");
        }
    }

    register aboveasbelow;
    "aboveasbelow" {
        in executing {
            result.get(index-1).value.data(result.get(index+1));
        }
    }

