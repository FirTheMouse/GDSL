    newstage htmlemiting;

    register text;
    "text" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source.append("<p");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).value.getStr);
            source.append("</p>");
            emit_contents;
        }
    }

    register script;
    "script" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source.append("<script");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).name);
            source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            node.children.push(result.take(index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            source.append("<style");
            emit_inline_html;
            source.append(">");
            source.append(node.children.get(0).name);
            source.append("</style>");
        }
    }

    "FUNC_DECL" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            if(node.value.type==to_type("inlined")) {return;}
            if(node.value.type==to_type("invisible")) {return;}
            source.append("<div");
            emit_inline_html;
            source.append(">");
            emit_contents;
            source.append("</div>");
        }
    }
    "FUNC_CALL" {
        in htmlemiting {
            if(node.value.type==to_type("inlined")) {return;}
            if(node.value.type==to_type("invisible")) {return;}
            source.append("<div");
            emit_inline_html;
            source.append(">");
            emit_contents;
            source.append("</div>");
        }
    }

    register emit_block;
    "emit_block" {
        in executing {
            source.append("<html><body>");
            emit_contents;
            source.append("</body></html>");
        }
    }

    register aboveasbelow;
    "aboveasbelow" {
        in executing {
            result.get(index-1).value.data(result.get(index+1));
        }
    }

