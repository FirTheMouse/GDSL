Ptr int nums; nums.push(3); nums.push(6); nums.push(9); nums.push(12);

print(*nums[+][+]);
print(*nums[++]);
nums++;
print(nums[-?]);
print(nums?--?);

nums.iter([nums](num){
    print("Num: ",num);
    if(num-?) {
        print(*-num);
    }
    if(num+?) {
        print(*+num);
    }
    if(num++?) {
        print(*++num);
    }
    if(?+num) {
        print(*(&num)[+]);
    }
});



func f = [](n){print("Num: ",n);}
nums.iter(f);


ColCol l = utypes.add;
string s = l.add(char);
s = "word";
s.iter([](c){
    print(c);
    if(c+?) {
        print("+",*+c);
    }
});
cast_to(#string,l.add(char)) = "hello";
l.iter([](cc){
    (&cc).iter([](c){
        if(c-?) {
            print(*-c);
        }
    });
});


void countdown(int n) {
    if(n < 0) return;
    print(n);
    if(n-?) {print("was: ",*-n);}
    if(n+?) {print("Last time: ",*+n);}
    countdown(n - 1);
}
countdown(3);
countdown(5);


