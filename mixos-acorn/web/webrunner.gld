##
    "node" {
        on ".\"left\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(0));
        }
        on ".\"right\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(1));
        }
        on ".\"scope_owner\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.scopes.get(0).owner);
        }
        on ".\"climb\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.in_scope.owner);
        }
    }
##

##
    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<p");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</p>");
            emit_contents;
        }
    }

    register input;
    "input" {
        in htmlemiting {
            ctx.source.append("<input");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register button;
    "button" {
        in htmlemiting {
            ctx.source.append("<button");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</button>");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            ctx.source.append("<script");
            emit_inline_html;
            ctx.source.append(">");
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            ctx.source.append("<style");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).name);
            ctx.source.append("</style>");
        }
    }

   global string node_str_id(Node n) {
        string to_return = n.name+"_"+to_string(n.asID);
        return to_return;
    }

    "component" {
        in htmlemiting {
            ctx.source.append("<div");
            if(ctx.node.name=="div") {

            } else {
                ctx.source.append(" id=\"");
                ctx.source.append(node_str_id(ctx.node));
                ctx.source.append("\"");
            }
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            ctx.source.append("<img ");
            emit_inline_html;
            ctx.source.append(">");
        }
    }

    register table;
    "table" {
        in htmlemiting {
            ctx.source.append("<table");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</table>");
        }
    }

    register row;
    "row" {
        in htmlemiting {
            ctx.source.append("<tr");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</tr>");
        }
    }

    register column;
    "column" {
        in htmlemiting {
            ctx.source.append("<td");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</td>");
        }
    }

    register select;
    "select" {
        in htmlemiting {
            ctx.source.append("<select");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</select>");
        }
    }

    register option;
    "option" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<option");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</option>");
            emit_contents;
        }
    }

    global string get_nsrc(string target) {
        string nsrc = "FRAG "+target+" ";
        return nsrc;
    }
    global string emit_reload(Context c, Node n) {
        ctx.source.append(get_nsrc(node_str_id((n))));
        htmlemit n;
        c.source.append(ctx.source);
        return ctx.source;
    }

    "component" {
        on ".\"reload\"" {
            emit_reload(ctx.sub,ctx.node.left.scope_owner);
        }
    }

    //save_sheet(create_sheet,"wip");
    //save_sheet(create_sheet,"redberry");
##

global Session session;

print("Session ip: ",session.ip);

print("Compiling");
    tstart("twig_compile");
Node twig = compile(read_file("mixos-acorn/web/thistle/thistle.twg"));
//Node twig = compile(read_file("mixos-acorn/web/test.twg"));
print("Compiled in: ",tstop("twig_compile"));
Node page = twig.children.get(0);

print(unit_info);

int cfd = 0;
while(0<1) {
    if(unit_index!=0) {
        cfd = unit_index;
        tstart("request_timer");
        print("Unit ",unit_uid," recived request ",cfd);
        string req = unit_label;
        //print("Req:\n",req);

        string first_line = req.substr(0, req.find("\r\n"));
        string method = first_line.substr(0, first_line.find(" "));
        string slashpath = first_line.slice(" ", 1, 2);
        string path = slashpath.substr(1,slashpath.length-1); //Strip the slash
        print("Method: ",method);
        print("Path: ",slashpath);

        if(path.length==0) {
            path = "root_path"; //For routing
        } else if(path=="favicon.ico") {
            close(cfd);
            print("Unit ",unit_uid," completed favicon request ",cfd);
            unit_setindex(0);
            continue;
        }
        for(int i=0;i<twig.children.length;i++) {
            Node child = twig.children.get(i);
            if(labels(child.type)==path) {
                page = child; //Because I haven't added break yet
            }
        }

        string response_body = "";
        string response = "";

        if(method=="GET") {
            ctx.source = "";
            htmlemit page;
            response_body.append(ctx.source);
        }

        if(method=="POST") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                ctx.source = src;
                post page;
                response.append(ctx.source);
            }
        }

        if(method=="FRAG") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                ctx.source = src;
                frag page;
                response_body.append(ctx.source);
            }
        }

        if(method=="RUN_RAW") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                print("Running raw:\n",src);

                Node root = compile(src);
                execut root;

                src = ctx.source;
                string target = src.slice(0,src.find(" "));
                string instr = src.slice(" ",1,2);
                string content = src.slice(src.find(" ",0,2)+1,src.length);
                if(target.length!=0) {
                    print("TARGET: ",target); 
                    print("INSTR: ",instr); 
                    print("CONTENT LEN: ",content.length);
                    response_body = content;
                }
            }
        }

        if(method=="RUN") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                print("Running:\n",src);

                Ptr string args = split_str(src,"@");
                ctx.source = "go";
                Ptr pointer = string_to_Ptr(args.get(0));
                Node root = cast_to_Node(pointer);

                if(args.length>1) {
                    for(int a=1;a<args.length;a++) {
                        //print("Child ",a,": ",root.children.get(a-1));
                        //print("Arg ",a,": ",args.get(a));
                        if(args.get(a)=="[VAR]") {
                            root.children.get(a-1).value.set(args.get(a+1));
                        }
                    }
                }

                    tstart("executing_run_root");
                execut root;
                //ursw;
                //udump;
                print("Time: ",tstop("executing_run_root"));
                //write_file("fire.svg",uspan_flame_chart);

                print("Finished root execution");

                src = ctx.source;
                string target = src.slice(0,src.find(" "));
                string instr = src.slice(" ",1,2);
                string content = src.slice(src.find(" ",0,2)+1,src.length);
                if(target.length!=0) {
                    print("TARGET: ",target); 
                    print("INSTR: ",instr); 
                    print("CONTENT LEN: ",content.length); 
                    response_body = content;
                    //response_body = "<div id=\""+instr+"\">"+uspan_flame_chart+"</div>";
                }
            }
        }

        if(response.length==0) {
            response.append("HTTP/1.1 200 OK\r\n");
            response.append("Content-Type: text/html\r\n");
            response.append("Content-Length: ");
            response.append(to_string(response_body.length));
            response.append("\r\n\r\n");
            response.append(response_body);
        } else {
            print("PREFILLED RESPONSE:\n",response);
        }
        write(cfd,response); 
        close(cfd);

        print("Unit ",unit_uid," completed request ",cfd," in ",tstop("request_timer"));
        unit_setindex(0);
    } else {
        thread_sleep;
    }
}