##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
        in fraging {
            string src = source;
            print("SRC: ",src);
            string target = src.slice(0,src.find(" "));
            string instr = src.slice(" ",1,2);
            string content = src.slice(src.find(" ",0,2)+1,src.length);
            print("TARGET: ",target); 
            print("INSTR: ",instr); 
            print("CONTENT: ",content); 
            Node to_edit = find_node(target,node);
            if(instr=="add") {
                to_edit.children.get(0).value.getStr.append(content);
                ctxsource(src);
                ctxsource.clear;
                htmlemit to_edit;
            }
            ctxsource(src);
        }
    }
##

root_path {
    div root {
        script read_file("mixos-acorn/web/thistle.js");

        inlined background_theme {
            "background-color" : "blue";
        } 

        div twub {
            background_theme;
            text "wub" {
                "color" : "purple";
                "onclick" : "post('wub')";
            }

            div temp(string clr, string word)  {
                text word {
                    "color" : clr;
                }
            }

            temp("red","RED");
            temp("green","GREEN");
        }

        div qwob {
            background_theme;
            text "wubria" {
                "color" : "red"; 
                "id" : "wubria";
                "onclick" : "fragthree('wubria', 'add', 'not')";
            }
        }
    }
}

##
    register r2;
    "r2" {
        in htmlemiting {
            emit_contents;
        }
    }
##

r2 {
    div contents {
        "id" : "r2";
        div testtxt {
            "background-color" : "blue";
            text "hello world" {
                "color" : "red";
            }
        }
    }
}

