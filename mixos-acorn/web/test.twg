
##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##


stateless template div iterbtn(int i) {
    div iterpanel {
        print("Redering iterpanel with i: ",IV#i);
        button {
            int riter = i-randi(1,3);
            text to_string(riter);
            "onclick" : capture(
                string toreload ; js_lit(to_string(cast_to_Ptr(call_owner(iterpanel)))),
                string iter ; js_lit(to_string(riter))
            ) {
                print("Button ",i," clicked, value ",riter);
                print("As iter ",iter);
                print("To reload: ",toreload);
                Ptr p = from_string(toreload);
                print("P: ",p);
                Node fp = cast_to_Node(p);
                emit_reload(ctx,fp);
            }
        }
    }
}

stateless template div frombtn(int from) {
    div panel {
        "display" : "flex";
        "flex-direction" : "column";
        text to_string(from) {
            "onclick" : capture {
                print("Reloading panel");
                panel.reload;
            }
        }   
        for(int i=0;i<3;i++) {
            print("Btn ",i," in ",from);
            iterbtn(from+randi(0,6));
        }
    }
}


root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    div {
        for(int i=0;i<3;i++) {
            int r = randi(0,10);
            print("From ",i," has ",r);
            frombtn(r);
        }
    }
}