Ptr listOf(int depth) {
    if(depth<2) {
        return listOf(2);
    }
    Ptr nums = [1,2,3,4,5];
    return nums.clone;
}

void main {
    Ptr int nums = listOf(0); nums.push(18);
    Ptr int tums = listOf(0); tums.push(19);

    Ptr numsf = nums.clone.filter(n => {n<4});
    numsf.do(c =>  print((&c).celllabel,": ",c));
    print("NUMS: ");
    nums.do(c =>  print((&c).celllabel,": ",c));
    print("TUMS: ");
    tums.do(c =>  print((&c).celllabel,": ",c));
}
main;