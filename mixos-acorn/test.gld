##
    global bool sheet_handler(Context c) {
        print(c.node.name);
        if(c.node.name=="two") {
            return 1;
        } else {
            return 0;
        }
    }
##


##
    register wub;
    "wub" {
        in naming {
            ctx.node.name = ctx.result.get(ctx.index+1).name;
        }
        in executing {
            if(sheet_handler(ctx)) {
                print("Sheets handled");
            } else {
                print("Unhandled sheets");
            }
        }
    }
##

print("Running");
wub one;
print("Wubbing two");
wub two;
print("Done");
print("And finished");