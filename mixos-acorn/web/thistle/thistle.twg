build {
    div build_root {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                box-sizing: border-box;
            }
        ";

        script read_file("mixos-acorn/web/thistle/thistle.js");

        background_theme;
        div {
            "display" : "flex";
            "min-height" : "100vh";
                side_bar("build");
                div build_sheet_panel {
                    sidebar_reload_target = call_owner(build_sheet_panel);
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "justify-content" : "start";
                    "align-items" : "center";
                        div {
                            "height" : "5%";
                            "width" : "100%";
                            "display" : "flex";
                            "gap" : "8px";

                                stateless template div control_btns(string label, string behaviour) { 
                                    button {
                                        "onclick" : behaviour;
                                        "height" : "100%"; 
                                        "width" : "40px"; 
                                        text label { text_theme; }
                                    } 
                                }

                                control_btns("S",capture{save_sheet(sheetpool,sheetname);});
                                control_btns("+C",capture{add_column_to_sheet(sheetpool); build_sheet_panel.reload;});
                                control_btns("+R",capture{add_row_to_sheet(sheetpool); build_sheet_panel.reload;});                              
                        }

                        div {
                            "display" : "flex";
                            "justify-content" : "flex-start";
                            "align-items" : "stretch";
                            "flex-direction" : "column";
                            "width" : "480px";
                            "padding" : "40px";
                            "gap" : "12px";
                            card_theme;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";
                            if(sheetpool!=0) {
                                build_render_sheet(sheetpool);
                            }
                        } 
                }
        }
    }
}



