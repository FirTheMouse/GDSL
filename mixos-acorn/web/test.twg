
##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##

##
    global string js(string s) {
        print("Catching");
        string str = "(()=>{"+s+"})()";
        print(str);
        return str;
    }
##

root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    div {
        template div dropdown(string label) {
            string open;
            div display {
                if(open=="yes") {
                    text "I'm open";
                } else {
                    text "I'm closed";
                }
            }
            div {
                button {
                    text label;
                    "background-color" : "red";
                    "onclick" : capture(
                            string recive; "'my_id'", 
                            string recivejs; js_do("console.log('hello'); return 'val';"), 
                            string other; js_lit(label)) 
                        {
                            print("Recived: ",recive);
                            print("Other: ",other);
                            print("JS: ",recivejs);
                            print("Label: ",label);
                            if(open=="yes") {
                                open = "no";
                            } else {
                                open = "yes";
                            }
                            display.reload;
                    }
                }
            }
        }   

        for(int i=0;i<3;i++) {
            dropdown(to_string(i));
                    DEBUG_ROOT;
        }
    }
}