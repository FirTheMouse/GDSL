##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##

##
    global string js(string s) {
        print("Catching");
        string str = "(()=>{"+s+"})()";
        print(str);
        return str;
    }
##

root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    div {
        template div dropdown(string label, string behaviour) {
            string open;
            div display {
                if(open=="yes") {
                    text "I'm open";
                } else {
                    text "I'm closed";
                }
            }
            div {
                button {
                    text label;
                    "background-color" : "red";
                    "onclick" : behaviour;
                }
            }
        }   

        dropdown("A",capture{print("Hello world!");});
        DEBUG_ROOT;
    }
}