ledger.add(Ptr,"sessions").clear_lock;
ColCol users = sub.add("Users");
users.clear_lock;
Object user_fir = users.Object(
    "username": "Fir";
    "password": "pswd123";
    "votes": [Ptr];
    "locked": false;
    "authourized": true;
).register("a0001");
ledger["sessions"].put("Fir",user_fir);

if(true) {
    print("Unit ",unit_uid," running");
    string username = "Joe";
    string password = "Pswd";
    RemotePtr database = make_new_remote;
    print(database.transact(k => {
        int i = 5;
        print("I: ",i," Username: ",username," Password: ",password);
        print(IV#k);
        return "Stringy";
    }));
    print("Unit ",unit_uid," done");
