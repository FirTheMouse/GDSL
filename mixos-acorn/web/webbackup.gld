Node twig;
int counter = 0;
while(1>0) {
print("Compiling");
    tstart("twig_compile");
twig = compile(read_file("mixos-acorn/web/thistle/thistle.twg"));
//Node twig = compile(read_file("mixos-acorn/web/test.twg"));
    print("Compiled twig ",counter," in: ",tstop("twig_compile"));
    print("Handlers: ",plen(0)," Layouts: ",plen(1)," Names: ",plen(2)," Nodes: ",plen(3)," Values: ",plen(4));
    counter++;
}
