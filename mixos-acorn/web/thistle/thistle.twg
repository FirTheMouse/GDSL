##
    int sheetid = 0;
    register audit;
    "audit" {
        in htmlemiting {
            emit_contents;
        }
        in fraging {
            string src = ctx.source;
            string target = src.slice(0,src.find(" "));
            string instr = src.slice(" ",1,2);
            string content = src.slice(src.find(" ",0,2)+1,src.length);
            print("TARGET: ",target); 
            print("INSTR: ",instr); 
            print("CONTENT: ",content); 
            Node to_edit = find_node(target,ctx.node);
            //print("TO EDIT: ",to_edit);

            ctx.source = "";
            if(instr=="loadsheet") {
                sheetid = load_sheet(content);
                to_edit.opt_str = content;
                to_edit.value.set(sheetid);
                if(to_edit.value.loc<0) {to_edit.value.loc = 0;}
                //print("LOADED: ",to_edit.value.getInt);
            } 
            if(instr=="add_column") {
                add_column_to_sheet(to_edit.value.getInt,stoi(content));
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="add_row") {
                add_row_to_sheet(to_edit.value.getInt,stoi(content));
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="add_row_col") {
                add_row_to_col(to_edit.value.getInt,to_edit.value.loc,stoi(content));
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="remove_row_col") {
                remove_row_from_col(to_edit.value.getInt,to_edit.value.loc,stoi(content));
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="add_form") {
                add_form(to_edit.value.getInt);
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="setcell") {
                setcell(content);
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="labelcell") {
                labelcell(content);
                save_sheet(to_edit.value.getInt,to_edit.opt_str);
            } 
            if(instr=="rendermode") {
                if(content=="+") {
                    to_edit.value.loc = to_edit.value.loc+1;
                } else {
                    if(content=="-") {
                        to_edit.value.loc = to_edit.value.loc-1;
                    } else {
                        to_edit.value.loc = stoi(content);
                    }
                }
            }
            if(instr=="to_debug") {
                to_edit.type = to_type("debugsheet");
            }
            if(instr=="to_sheet") {
                to_edit.type = to_type("sheet");
            }
            if(instr=="to_form") {
                to_edit.type = to_type("form");
            }
            htmlemit to_edit;
        }
    }
