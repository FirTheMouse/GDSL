    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<p");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</p>");
            emit_contents;
        }
    }

    register input;
    "input" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<input");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register button;
    "button" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<button");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</button>");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            ctx.source.append("<script");
            emit_inline_html;
            ctx.source.append(">");
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<style");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).name);
            ctx.source.append("</style>");
        }
    }

    "FUNC_DECL" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            if(0<ctx.node.children.length) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
    "FUNC_CALL" {
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }

    register sheet;
    "sheet" {
        in naming {
            ctx.node.name = ctx.result.take(ctx.index+1).name;
        }
        in resolving {
            gather_props;
            ctx.node.value = make_value(to_type("int"),4);
        }
        in htmlemiting {
            int vloc = ctx.node.value.loc;
            if(vloc<0) {
                render_sheet(ctx.node.value.getInt,0,"sheet");
            } else if(vloc<5) {
                render_sheet(ctx.node.value.getInt,vloc,"sheet");
            } else {
                render_sheet(ctx.node.value.getInt,vloc,"form");
            }
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            ctx.source.append("<img ");
            emit_inline_html;
            ctx.source.append(">");
        }
        in resolving {
            gather_props;
        }
    }

    register table;
    "table" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<table");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</table>");
        }
    }

