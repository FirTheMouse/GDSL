##
    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<p");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</p>");
            emit_contents;
        }
    }

    register input;
    "input" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<input");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register button;
    "button" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<button");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</button>");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            ctx.source.append("<script");
            emit_inline_html;
            ctx.source.append(">");
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<style");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).name);
            ctx.source.append("</style>");
        }
    }

    "FUNC_DECL" {
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            if(0<ctx.node.children.length) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
    "FUNC_CALL" {
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }

    register sheet;
    "sheet" {
        in naming {
            ctx.node.name = ctx.result.take(ctx.index+1).name;
        }
        in resolving {
            gather_props;
            ctx.node.value = make_value(to_type("int"),4);
        }
        in htmlemiting {
            render_sheet(ctx.node.value.getInt,"sheet");
        }
    }

    register form;
    "form" {
        in naming {
            ctx.node.name = ctx.result.take(ctx.index+1).name;
        }
        in resolving {
            gather_props;
            ctx.node.value = make_value(to_type("int"),4);
        }
        in htmlemiting {
            render_sheet(ctx.node.value.getInt,"form");
        }
    }

    register debugsheet;
    "debugsheet" {
        in naming {
            ctx.node.name = ctx.result.take(ctx.index+1).name;
        }
        in resolving {
            gather_props;
            ctx.node.value = make_value(to_type("int"),4);
        }
        in htmlemiting {
            render_sheet(ctx.node.value.getInt,"debug");
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            ctx.source.append("<img ");
            emit_inline_html;
            ctx.source.append(">");
        }
        in resolving {
            gather_props;
        }
    }

    register table;
    "table" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<table");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</table>");
        }
    }

    //save_sheet(create_sheet,"wip");
    //save_sheet(create_sheet,"redberry");
##

print("Compiling");
Node twig = compile(read_file("mixos-acorn/web/thistle/thistle.twg"));
print("Compiled");
Node page = twig.children.get(0);

while(0<1) {
    int cfd = unit_index;
    if(cfd!=0) {
        print("Unit ",unit_uid," recived request ",cfd);
        string req = unit_label;
        //print("Req:\n",req);

        string first_line = req.substr(0, req.find("\r\n"));
        string method = first_line.substr(0, first_line.find(" "));
        string slashpath = first_line.slice(" ", 1, 2);
        string path = slashpath.substr(1,slashpath.length-1); //Strip the slash
        print("Port 8080");
        print("Method: ",method);
        print("Slashpath: ",slashpath);
        print("Path: ",path);

        if(path.length==0) {
            path = "root_path"; //For routing
        }
        for(int i=0;i<twig.children.length;i++) {
            Node child = twig.children.get(i);
            if(labels(child.type)==path) {
                page = child; //Because I haven't added break yet
            }
        }

        string response_body = "";
        string response = "";

        if(method=="GET") {
            ctx.source = "";
            htmlemit page;
            response_body.append(ctx.source);
        }

        if(method=="POST") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                ctx.source = src;
                post page;
                response.append(ctx.source);
            }
        }

        if(method=="FRAG") {
            int body_start = req.find("\r\n\r\n");
            if(body_start>=0) {
                string src = req.slice(body_start+4,req.length);
                ctx.source = src;
                frag page;
                response_body.append(ctx.source);
            }
        }

        if(response.length==0) {
            response.append("HTTP/1.1 200 OK\r\n");
            response.append("Content-Type: text/html\r\n");
            response.append("Content-Length: ");
            response.append(to_string(response_body.length));
            response.append("\r\n\r\n");
            response.append(response_body);
        } else {
            print("PREFILLED RESPONSE:\n",response);
        }
        write(cfd,response); 
        close(cfd);

        print("Unit ",unit_uid," completed request ",cfd);
        unit_setindex(0);
    } else {
        thread_sleep;
    }
}