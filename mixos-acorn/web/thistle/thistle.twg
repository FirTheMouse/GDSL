##
    global int sheetid = 0;
    global int sheet_frag_handler(Context c, string target, string instr, string content, Node to_edit) {
        if(instr=="loadsheet") {
            sheetid = load_sheet(content);
            to_edit.opt_str = content;
            to_edit.value.set(sheetid);
            //print("LOADED: ",to_edit.value.getInt);
        } 
        if(instr=="add_column") {
            add_column_to_sheet(to_edit.value.getInt);
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="add_row") {
            add_row_to_sheet(to_edit.value.getInt);
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="add_row_col") {
            add_row_to_col(to_edit.value.getInt,stoi(content));
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="remove_row_col") {
            remove_row_from_col(to_edit.value.getInt,stoi(content));
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="add_form") {
            add_form(to_edit.value.getInt);
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="setcell") {
            setcell(content);
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="labelcell") {
            labelcell(content);
            save_sheet(to_edit.value.getInt,to_edit.opt_str);
        } 
        if(instr=="rendermode") {
            if(content=="+") {
                to_edit.value.set(to_edit.value.getInt+1);
            } else {
                if(content=="-") {
                    to_edit.value.set(to_edit.value.getInt-1);
                } else {
                    to_edit.value.set(stoi(content));
                }
            }
        }
        if(instr=="to_debug") {
            to_edit.type = to_type("debugsheet");
        }
        if(instr=="to_sheet") {
            to_edit.type = to_type("sheet");
        }
        if(instr=="to_form") {
            to_edit.type = to_type("form");
        }
    }   
##

##
    register build;
    "build" {
        in htmlemiting {
            emit_contents;
        }
        in fraging {
            string src = ctx.source;
            string target = src.slice(0,src.find(" "));
            string instr = src.slice(" ",1,2);
            string content = src.slice(src.find(" ",0,2)+1,src.length);
            print("TARGET: ",target); 
            print("INSTR: ",instr); 
            print("CONTENT: ",content); 
            if(target.length!=0) {
                Node to_edit = find_node(target,ctx.node);
                ctx.source = "";
                sheet_frag_handler(ctx,target,instr,content,to_edit);
                htmlemit to_edit;
            } else {
                print("No target for frag request!");
            }
        }
    }
##


template div build_render_sheet(int spool) {
    div {
        "display" : "flex";
        "justify-content" : "center";
        "width" : "100%";
            table {
                "border-collapse" : "collapse";
                "width" : "100%";
                    int lenc = plen(spool); //Columns
                    int lenr = 0; //Rows

                    //Headers
                    row {
                        for(int i=0;i<lenc;i++) {
                            column {
                                "background-color" : "rgb(240, 240, 240)";
                                "padding" : "10px 12px";
                                "font-size" : "14px";
                                "color" : "rgb(26, 26, 26)";
                                "font-size" : "13px";
                                "font-weight" : "600";
                                "color" : "rgb(80,80,80)";
                                "font-family" : "system-ui, sans-serif";
                                "border-right" : "1px solid rgb(200,200,200)";
                                text clabel(spool,i);
                            }
                            int lenco = clen(spool,i);
                            if(lenco>lenr) {
                                lenr = lenco;
                            }
                        }
                    }
                    
                    //Render each column
                    for(int r=0;r<lenr;r++) {
                        row {
                            "border-bottom" : "1px solid rgb(220,220,220)";
                                for(int c=0;c<lenc;c++) {
                                    column {
                                        "border-right" : "1px solid rgb(200,200,200)";
                                            string tostr = "";
                                            Ptr cellptr = makePtr3(spool,c,r);
                                            Ptr p = resolve_as_Ptr(cellptr);
                                            if(is_live(p)) {
                                                tostr = value_as_string(p);
                                            }
                                            input {
                                                "border" : "none";
                                                "background-color" : "transparent";
                                                "width" : "100%";
                                                "padding" : "8px 4px";
                                                "font-size" : "13px";
                                                "font-family" : "system-ui, sans-serif";
                                                "value" : tostr;                                                                    
                                                "onchange" : escape_str("run('setcell(\""+to_string(cellptr)+"=',this.value,'\")')");
                                            }
                                    }
                                }
                        }
                    }
            }
    }
}

build {
    div build_root {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                box-sizing: border-box;
            }
        ";

        script read_file("mixos-acorn/web/thistle/thistle.js");

        background_theme;
        div {
            "display" : "flex";
            "min-height" : "100vh";
                side_bar;
                div build_sheet_panel {
                    sidebar_reload_target = call_owner(build_sheet_panel);
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "justify-content" : "start";
                    "align-items" : "center";
                        div {
                            "height" : "5%";
                            "width" : "100%";
                            "display" : "flex";
                            "gap" : "8px";

                                template div control_btns(string label, string behaviour) { 
                                    button {
                                        "onclick" : behaviour;
                                        "height" : "100%"; 
                                        "width" : "40px"; 
                                        text label { text_theme; }
                                    } 
                                }

                                control_btns("S","save_sheet("+to_string(sheetpool)+",\""+sheetname+"\")");
                                control_btns("+C","add_column_to_sheet("+to_string(sheetpool)+"); emit_reload(ctx,cast_to_Node("+call_owner_as_string(build_sheet_panel)+"))");
                                control_btns("+R","add_row_to_sheet("+to_string(sheetpool)+"); emit_reload(ctx,cast_to_Node("+call_owner_as_string(build_sheet_panel)+"))");                              
                        }

                        div {
                            "display" : "flex";
                            "justify-content" : "flex-start";
                            "align-items" : "stretch";
                            "flex-direction" : "column";
                            "width" : "480px";
                            "padding" : "40px";
                            "gap" : "12px";
                            card_theme;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";
                            if(sheetpool!=0) {
                                build_render_sheet(sheetpool);
                            }
                        } 
                }
        }
    }
}



