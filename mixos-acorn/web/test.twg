inlined banner_theme {
    "background-color" : "rgb(40, 28, 89)";
}
inlined card_theme {
    "border-radius" : "8px";
    "background-color" : "rgb(67, 67, 67)";
}
inlined pill_theme {
    "border-radius" : "10px";
    "background-color" : "rgb(205, 253, 255)";
    "display" : "flex";
    "align-items" : "center";
    "justify-content" : "center";
}
inlined main_font {
    "font-family" : "system-ui, sans-serif";
}
inlined text_one_theme {
    "font-size" : "15px";
    "font-weight" : "800";
    "color" : " rgb(251, 251, 251)";
    main_font;
}
inlined text_two_theme {
    "font-size" : "12px";
    "font-weight" : "400";
    "color" : " rgb(207, 207, 207)";
    main_font;
}
inlined text_three_theme {
    "font-size" : "10px";
    "font-weight" : "400";
    "color" : " rgb(30, 42, 87)";
    main_font;
}

##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##

root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    button {
        text "RESET";
        "onclick" : "resetWebrunner();";
    }


    div {
        "display" : "flex";
        "width" : "100%";
        "height" : "100%";
        "align-items" : "top";
        "flex-direction" : "column";
        div {
            "display" : "flex";
            "flex-direction" : "row";
            "width" : "100%";
            "height" : "10%";
            "align-items" : "center";
            "justify-content" : "center";
            "padding" : "10px";
            banner_theme;
            div {
                "flex" : "1";
                text "My App" {"font-size" : "24px"; text_one_theme;}
            }
            div {
                "flex" : "3";
                "display" : "flex";
                "flex-direction" : "row";
                stateless template div nav(string label, string behaviour) {
                    div {
                        "flex" : "1";
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "background-color" : "transparent";
                        "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.25)'";
                        "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.25)')this.style.backgroundColor='transparent'";
                        text label {
                            "font-size" : "14px";
                            text_two_theme;
                        }
                        "onclick" : behaviour;
                    }
                }
                nav("Home","goTo('/home')");
                nav("About","goTo('/about')");
                nav("Projects","goTo('/projects')");
                nav("Contact","goTo('/contact')");
            }
            div {
                "flex" : "1";
                "padding" : "24px";
                div {
                    "border-radius" : "10px";
                    "background-color" : "rgb(140, 68, 212)";
                    "display" : "flex";
                    "align-items" : "center";
                    "justify-content" : "center";
                    text "Sign in" {
                        "font-weight" : "600";
                        text_one_theme;
                    }
                }
            }
        }
        string display_tab;
        display_tab = "Dashboard";
        div display_root {
            "flex" : "1";
            "display" : "flex";
            "flex-direction" : "row";
            "gap" : "10px";
            div {
                "width" : "20%";
                "height" : "100%";
                stateless template div sidebar_nav(string label) {
                    div {
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "border-radius" : "8px";
                        "background-color" : (display_tab==label?"rgb(146, 213, 239)":"transparent");
                        "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
                        "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
                        text label {
                            "font-size" : "14px";
                            "color" : "rgb(66, 66, 66)";
                            text_two_theme;
                        }
                        "onclick" : capture(
                            string flabel ; js_lit(label)
                        ){
                            display_tab = flabel;
                            display_root.reload;
                        }
                    }
                }
                "background-color" : "rgb(240, 240, 240)";
                sidebar_nav("Dashboard");
                sidebar_nav("Settings");
                sidebar_nav("Profile");
                sidebar_nav("Billing");
            }
            div {
                "flex" : "1";
                "display" : "flex";
                "width" : "80%";
                "padding" : "40px";
                "align-items" : "center";
                "justify-content" : "center";
                "background-color" : "rgb(203, 203, 203)";
                "flex-direction" : "column";
                "gap" : "5%";
                div {
                    "flex" : "1";
                    "display" : "flex";
                    "align-items" : "center";
                    "justify-content" : "flex-start";
                    "width" : "100%";
                    "height" : "100%";
                    "padding" : "-16px";
                    text "Dashboard" {
                        "color" : "rgb(60, 60, 60)";
                        "font-size" : "24px";
                        text_one_theme;
                    }
                }

                div {
                    "flex" : "2";
                    "display" : "flex";
                    "flex-direction" : "row";
                    "border-radius" : "10px";
                    "align-items" : "center";
                    "justify-content" : "center";
                    "width" : "100%";
                    "margin" : "4px";
                    "gap" : "5%";
                    stateless template div dashboard_card(string label, string data) {
                        div {
                            "flex" : "1";
                            "display" : "flex";
                            "flex-direction" : "column";
                            "padding" : "8px";
                            "border-radius" : "10px";
                            "background-color" : "rgb(246, 246, 246)";
                            text label {
                                "margin-top" : "8px";
                                "margin-bottom" : "0";
                                "font-weight" : "600";
                                "color" : "rgb(110, 109, 109)";
                                text_two_theme;
                            }
                            text data {
                                "margin-top" : "0";
                                "margin-bottom" : "0";
                                "font-size" : "24px";
                                "color" : "rgb(42, 42, 42)";
                                text_one_theme;
                            }
                        }
                    }
                    dashboard_card("Total users","1,284");
                    dashboard_card("Revenue","$8,492");
                    dashboard_card("Active sessions","342");
                }
                div {
                    "flex" : "5";
                    "display" : "flex";
                    "border-radius" : "10px";
                    "flex-direction" : "column"
                    "width" : "100%";
                    "padding" : "16px";
                    "background-color" : "rgb(236, 236, 236)";
                    text "Recent activity" {
                        "font-size" : "18px";
                        "color" : "rgb(66, 66, 66)";
                        text_one_theme;
                    }
                    text "No activity yet." {
                        "font-weight" : "600";
                        "color" : "rgb(69, 69, 69)";
                        text_two_theme;
                    }
                }
            }
        }
    }
}