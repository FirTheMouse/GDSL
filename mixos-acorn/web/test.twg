##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##


inlined red_background {
    "background-color" : "red";
}

root_path {

    div slotted(div tester) {
        text "words" {
            "color" : "blue";
        }
        tester;
    }

    div {
       slotted();
       slotted();
    }
}
