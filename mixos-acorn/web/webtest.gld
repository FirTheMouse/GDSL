##
    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<p");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</p>");
            emit_contents;
        }
    }

    register input;
    "input" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<input");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register button;
    "button" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<button");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</button>");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            ctx.source.append("<script");
            emit_inline_html;
            ctx.source.append(">");
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
        }
        in htmlemiting {
            ctx.source.append("<style");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).name);
            ctx.source.append("</style>");
        }
    }

    "FUNC_DECL" {
        in resolving {
            gather_props;
        }
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            if(0<ctx.node.children.length) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
    "FUNC_CALL" {
        in htmlemiting {
            if(ctx.node.value.type==to_type("inlined")) {return;}
            if(ctx.node.value.type==to_type("invisible")) {return;}
            ctx.source.append("<div");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }

    register sheet;
    "sheet" {
        in naming {
            ctx.node.name = ctx.result.take(ctx.index+1).name;
        }
        in htmlemiting {
            render_col(14);
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            gather_props;
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }
##

print("Compiling");
Node twig = compile(read_file("mixos-acorn/web/thistle.twg"));
//print("Compiled: ",twig);
Node page = twig.children.get(0);
execut twig;
print("Starting server");

int fd = socket;
bind(fd,8080);
listen(fd);
while(0<1) {
    int cfd = accept(fd);
    string req = read(cfd);

    string first_line = req.substr(0, req.find("\r\n"));
    string method = first_line.substr(0, first_line.find(" "));
    string slashpath = first_line.slice(" ", 1, 2);
    string path = slashpath.substr(1,slashpath.length-1); //Strip the slash
    print("Method: ",method);
    print("Slashpath: ",slashpath);
    print("Path: ",path);

    if(path.length==0) {
        path = "root_path"; //For routing
    }
    for(int i=0;i<twig.children.length;i++) {
        Node child = twig.children.get(i);
        if(labels(child.type)==path) {
            page = child; //Because I haven't added break yet
        }
    }

    string response_body = "";

    if(method=="GET") {
        ctx.source = "";
        htmlemit page;
        response_body.append(ctx.source);
    }

    if(method=="POST") {
        print(req);
    }

    if(method=="FRAG") {
        int body_start = req.find("\r\n\r\n");
        if(body_start>=0) {
            string src = req.slice(body_start+4,req.length);
            ctx.source = src;
            frag page;
            response_body.append(ctx.source);
        }
    }

    string response = "";
        response.append("HTTP/1.1 200 OK\r\n");
        response.append("Content-Type: text/html\r\n");
        response.append("Content-Length: ");
        response.append(to_string(response_body.length));
        response.append("\r\n\r\n");
        response.append(response_body);
        //print("RESPONSE: ",response);
    write(cfd,response); 
    close(cfd);
}
