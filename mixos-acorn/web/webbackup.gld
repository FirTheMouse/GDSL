            string open;
            div display {
                if(open=="yes") {
                    text "I'm open";
                } else {
                    text "I'm closed";
                }
            }
            div {
                button {
                    text label;
                    "background-color" : "red";
                    "onclick" : capture(
                            string recive; "'my_id'", 
