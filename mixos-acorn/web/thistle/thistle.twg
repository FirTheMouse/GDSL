                            text "Hello guest" {
                                "font-size" : "30px";
                                text_theme;
                            }
                        } else {
                            text "Welcome back "+session.username {
                                "font-size" : "30px";
                                text_theme;
                            }
                        }
                        div {
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            "width" : "480px";
                            "height" : "200px";
                            "padding" : "40px";
                            "gap" : "24px";
                            card_theme;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";
                                button {
                                    "id" : "to_new";
                                    "onclick" : "goTo('/new')";
                                    text "New" {
                                        "font-size" : "18px";
                                        text_theme;
                                    }
                                    basic_button;
                                }
                                button {
                                    "id" : "to_todo";
                                    "onclick" : "goTo('/build')";
                                    text "Build" {
                                        "font-size" : "18px";
                                        text_theme;
                                    }
                                    basic_button;
                                }
                                button {
                                    "id" : "to_sent";
                                    "onclick" : "goTo('/audit')";
                                    text "Audit" {
                                        "font-size" : "18px";
                                        text_theme;
                                    }
