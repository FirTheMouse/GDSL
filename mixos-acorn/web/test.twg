
##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##

##
    global string js(string s) {
        print("Catching");
        string str = "(()=>{"+s+"})()";
        print(str);
        return str;
    }
##

root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    div {
        template div dropdown(string label, int depth) {

            if(depth<2) {
                dropdown(label+"-1",depth+1);
            }

            static string open;
            div display {
                if(open=="yes") {
                    text "OPENED";
                } else {
                    text "CLOSED";
                }
                button  {
                    text "reload" {
                        "font-size" : "5px";
                    }
                    "onclick" : capture{ 
                        display.reload;
                    }
                }
            }
            div {
                button {
                    text label;
                    "background-color" : "red";
                    "onclick" : capture(
                            js_do("this.style.backgroundColor=(this.style.backgroundColor==='red'?'green':'red');"),
                            string other ; js_lit(label))
                        {
                            print("Captured label: ",other);
                            print("Label: ",label);
                            if(open=="yes") {
                                open = "no";
                            } else {
                                open = "yes";
                            }
                            display.reload;
                    }
                    
                }
            }
        }   
        int cmax = randi(1,6);
        int rmax = randi(1,6);

        table {
            for(int c=0;c<cmax;c++) {
                row {
                    for(int r=0;r<rmax;r++) {
                        column {
                            dropdown(to_string(c)+"-"+to_string(r),0);
                        }
                    }
                }
            }
        }
    }
}