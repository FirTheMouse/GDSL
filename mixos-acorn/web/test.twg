##
    global int sheetpool;
    sheetpool = 3;
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##


root_path {
    script read_file("mixos-acorn/web/thistle/thistle.js");
    print("Sheetpool: ",sheetpool);

    text "testing" {
        "onclick" : escape_str("run('print(\"Hello from Acorn_script\"); print(\"Sheetpool: \",sheetpool);')");
    }
}
