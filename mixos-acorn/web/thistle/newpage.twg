<html>
<body style="background-color:rgb(225, 225, 225);">
    <style>
    
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
                border-bottom: 2px solid rgb(68, 137, 50);
            }
    
            * {
                box-sizing: border-box;
            }
    
            td:first-child {
                border-right: none;
            }
            
            body, html {
                margin: 0;
                padding: 0;
            }
        
    </style>
    <div style="display:flex;min-height:100vh;">
    <div id="side_bar" style="width:60px;min-height:100vh;display:flex;flex-direction:column;transition:width 0.2s ease;overflow:hidden;background-color:rgb(247, 244, 244);">
        <div style="display:flex;flex-direction:column;align-items:flex-start;padding:12px 8px;border-bottom:1px solid rgb(220,220,220);gap:12px;">
        <div style="cursor:pointer;padding:8px;display:flex;align-items:center;justify-content:flex-end;white-space:nowrap;background-color:transparent;width:100%;height:30px;">
            <p onclick="goTo('/')" class="label" style="cursor:pointer;opacity:0;transition:opacity 0.15s ease;font-size:18px;flex:1;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
            THISTLE
            </p>
            <div onclick="toggleSidebar()" style="width:30px;height:30px;background-color:rgb(172, 57, 147);flex-shrink:0;">
            </div>
        </div>
        <div onclick="toggleSidebar()" style="cursor:pointer;padding:8px;display:flex;align-items:center;gap:10px;width:30px;height:30px;white-space:nowrap;background-color:transparent;">
            <div style="width:30px;height:30px;background-color:rgb(100, 100, 100);flex-shrink:0;">
            </div>
            <p class="label" style="opacity:0;transition:opacity 0.15s ease;font-size:16px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
            toggle
            </p>
        </div>
        </div>
        <div style="flex:1;display:flex;flex-direction:column;padding:8px 0px;">
        </div>
        <script>
        
                function toggleSidebar() {
                    const sidebar = document.getElementById('side_bar');
                    const expanded = sidebar.style.width === '220px';
                    sidebar.style.width = expanded ? '60px' : '220px';
                    document.querySelectorAll('.label').forEach(el => {
                        el.style.opacity = expanded ? '0' : '1';
                    });
                }
        
                function goTo(route) {
                    window.location.href = route;
                }
            
        </script>
    </div>
    <div style="flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;">
        <div class='form' id='form' style="max-width:480px;width:100%;padding:40px;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,0.08);background-color:rgb(247, 244, 244);">
        <p style="font-size:18px;color:rgb(57, 57, 57);font-weight:600;font-family:system-ui, sans-serif;">
            Numbers Form
        </p>
        <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
            <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
            Place of supply
            </label>
            <select  style="border:1px solid rgb(200,200,200);border-radius:8px;padding:10px 14px;width:100%;font-size:15px;font-family:system-ui, sans-serif;background-color:rgb(255, 249, 249);" value='' onchange="cell_post(this,'',0,0,'sheet');cell_post(this,'',0,1,'form')">
            <option value='ON'>
                ON, Ontario
            </option>
            <option value='QC'>
                QC, Quebec
            </option>
            <option value='PEI'>
                PEI, Prince Edward Island
            </option>
            </select>
        </div>
        <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
            <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
            Transaction Date
            </label>
            <input  style="border:none;border-bottom:2px solid rgb(200,200,200);border-radius:0px;background-color:transparent;padding:8px 0px;width:100%;font-size:15px;font-family:system-ui, sans-serif;" value='' onchange="cell_post(this,'',1,0,'sheet');cell_post(this,'',1,1,'form')">
            </div>
            <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
            <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                Expense Description
            </label>
            <input  style="border:none;border-bottom:2px solid rgb(200,200,200);border-radius:0px;background-color:transparent;padding:8px 0px;width:100%;font-size:15px;font-family:system-ui, sans-serif;" value='' onchange="cell_post(this,'',2,0,'sheet');cell_post(this,'',2,1,'form')">
            </div>
            <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
                <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                Department
                </label>
                <select  style="border:1px solid rgb(200,200,200);border-radius:8px;padding:10px 14px;width:100%;font-size:15px;font-family:system-ui, sans-serif;background-color:rgb(255, 249, 249);" value='' onchange="cell_post(this,'',3,0,'sheet');cell_post(this,'',3,1,'form')">
                <option value='BK'>
                    BK
                </option>
                <option value='TB'>
                    TB
                </option>
                </select>
            </div>
            <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
                <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                Vendor Name/Commentary
                </label>
                <input  style="border:none;border-bottom:2px solid rgb(200,200,200);border-radius:0px;background-color:transparent;padding:8px 0px;width:100%;font-size:15px;font-family:system-ui, sans-serif;" value='' onchange="cell_post(this,'',4,0,'sheet');cell_post(this,'',4,1,'form')">
                </div>
                <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
                <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                    Total Amount of Receipt
                </label>
                <input  style="border:none;border-bottom:2px solid rgb(200,200,200);border-radius:0px;background-color:transparent;padding:8px 0px;width:100%;font-size:15px;font-family:system-ui, sans-serif;" value='' onchange="cell_post(this,'',5,0,'sheet');cell_post(this,'',5,1,'form')">
                </div>
                <div  style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;" class='field'>
                    <label  style="font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                    Non Taxable Portion of Receipt
                    </label>
                    <input  style="border:none;border-bottom:2px solid rgb(200,200,200);border-radius:0px;background-color:transparent;padding:8px 0px;width:100%;font-size:15px;font-family:system-ui, sans-serif;" value='' onchange="cell_post(this,'',6,0,'sheet');cell_post(this,'',6,1,'form')">
                    </div>
                </div>                    <details>
                    <summary  style="width:480px;font-size:13px;font-weight:600;color:rgb(80,80,80);font-family:system-ui, sans-serif;">
                    spreadsheet
                    </summary>
                    <div style="max-width:480px;width:100%;padding:10px;overflow-x:auto;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,0.08);background-color:rgb(247, 244, 244);">
                    <table id='sheet'  style="border-collapse:collapse;background-color:rgb(247, 244, 244);">
                        <tr  style="border-bottom:1px solid rgb(220,220,220);">
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            place_of_supply
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            date
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            comments
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            department
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            vendor
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            amount
                        </th>
                        <th style="background-color:rgb(240, 240, 240);padding:10px 12px;font-size:14px;color:rgb(26, 26, 26);font-weight:600;font-family:system-ui, sans-serif;">
                            non_taxable_portion
                        </th>
                        </tr>
                        <tr  style="border-bottom:1px solid rgb(220,220,220);">
                        <td  style="border-right:1px solid rgb(200,200,200);">
                            <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="SELECT" onchange="cell_post(this,'place_of_supply',0,0,'sheet')"/>
                            </td>
                            <td  style="border-right:1px solid rgb(200,200,200);">
                            <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="ENTER DATE" onchange="cell_post(this,'date',1,0,'sheet')"/>
                            </td>
                            <td  style="border-right:1px solid rgb(200,200,200);">
                                <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="ENTER COMMENTS" onchange="cell_post(this,'comments',2,0,'sheet')"/>
                                </td>
                                <td  style="border-right:1px solid rgb(200,200,200);">
                                <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="SELECT" onchange="cell_post(this,'department',3,0,'sheet')"/>
                                </td>
                                <td  style="border-right:1px solid rgb(200,200,200);">
                                    <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="SELECT" onchange="cell_post(this,'vendor',4,0,'sheet')"/>
                                    </td>
                                    <td  style="border-right:1px solid rgb(200,200,200);">
                                    <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="0.000000" onchange="cell_post(this,'amount',5,0,'sheet')"/>
                                    </td>
                                    <td  style="border-right:1px solid rgb(200,200,200);">
                                        <input  style="border:none;background-color:transparent;width:100%;padding:8px 4px;font-size:13px;font-family:system-ui, sans-serif;" value="0.000000" onchange="cell_post(this,'non_taxable_portion',6,0,'sheet')"/>
                                        </td>

                                    </tr>
                                    </table>
                                </div>
                                </details>
                            </div>
                            </div>
                            <script>
                            function getel(id) { return document.getElementById(id); }
                            
                            function fragthree(target, instruction, content) {
                                fetch(window.location.pathname, {
                                    method: "FRAG",
                                    body: target+" "+instruction+" "+content
                                })
                                .then(r => r.text())
                                .then(html => {
                                    document.getElementById(target).outerHTML = html;
                                });
                            }
                            
                            function frag(target, instruction = "") {
                                fetch(window.location.pathname, {
                                    method: "FRAG",
                                    body: target + (instruction ? " " + instruction : "")
                                })
                                .then(r => r.text())
                                .then(html => {
                                    document.getElementById(target).outerHTML = html;
                                });
                            }
                            
                            function post(body) {
                                fetch(window.location.pathname, {
                                    method: "POST",
                                    body: body
                                })
                            }
                            
                            function cell_post(input, label, col, row, target) {
                                fetch(window.location.pathname, {
                                    method: "POST",
                                    body: label + " " + col + " " + row + " " + target + " " + input.value
                                }).then(() => frag(target));
                            }
                            
                            function postForm(fields) {
                                const body = Object.entries(fields)
                                    .map(([k,v]) => k + '=' + encodeURIComponent(v))
                                    .join('&');
                                fetch(window.location.pathname, {
                                    method: "POST",
                                    body: body
                                })
                                .then(res => res.text())
                                .then(role => {
                                    if(role === 'invalid') {
                                        // show error message on the login page
                                    } else {
                                        window.location.href = '/' + role;
                                    }
                                })
                            }
                            </script>
                        </body>
                        </html>